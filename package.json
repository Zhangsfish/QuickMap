{
  "name": "quick-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline Windows world map with local AI control",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "npm run typecheck && vite build && npm run build:desktop",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "mcp": "node dist-electron/mcp.cjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "d3-geo": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "world-countries": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
